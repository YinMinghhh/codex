{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ThreadContextWindowBreakdown": {
      "properties": {
        "components": {
          "items": {
            "$ref": "#/definitions/ThreadContextWindowComponent"
          },
          "type": "array"
        },
        "estimatedTotalTokens": {
          "format": "int64",
          "type": "integer"
        },
        "modelContextWindow": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "reportedInputTokens": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "segments": {
          "items": {
            "$ref": "#/definitions/ThreadContextWindowSegment"
          },
          "type": "array"
        }
      },
      "required": [
        "components",
        "estimatedTotalTokens",
        "segments"
      ],
      "type": "object"
    },
    "ThreadContextWindowCategory": {
      "enum": [
        "model_scaffold",
        "tool_schemas",
        "runtime_context",
        "project_user_context",
        "conversation",
        "tool_io",
        "model_state",
        "other"
      ],
      "type": "string"
    },
    "ThreadContextWindowComponent": {
      "properties": {
        "assemblyStepIds": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "category": {
          "$ref": "#/definitions/ThreadContextWindowCategory"
        },
        "contentHash": {
          "type": "string"
        },
        "estimatedBytes": {
          "format": "int64",
          "type": "integer"
        },
        "estimatedTokens": {
          "format": "int64",
          "type": "integer"
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "mappingConfidence": {
          "anyOf": [
            {
              "$ref": "#/definitions/ThreadContextWindowMappingConfidence"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "type": "string"
        },
        "target": {
          "$ref": "#/definitions/ThreadContextWindowTarget"
        },
        "value": true
      },
      "required": [
        "category",
        "contentHash",
        "estimatedBytes",
        "estimatedTokens",
        "id",
        "label",
        "source",
        "target",
        "value"
      ],
      "type": "object"
    },
    "ThreadContextWindowMappingConfidence": {
      "enum": [
        "exact_range",
        "exact_value",
        "derived",
        "classified_fallback"
      ],
      "type": "string"
    },
    "ThreadContextWindowSegment": {
      "properties": {
        "category": {
          "$ref": "#/definitions/ThreadContextWindowCategory"
        },
        "estimatedBytes": {
          "format": "int64",
          "type": "integer"
        },
        "estimatedTokens": {
          "format": "int64",
          "type": "integer"
        },
        "label": {
          "type": "string"
        },
        "percentOfReportedInput": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "category",
        "estimatedBytes",
        "estimatedTokens",
        "label"
      ],
      "type": "object"
    },
    "ThreadContextWindowTarget": {
      "properties": {
        "contentIndex": {
          "format": "uint",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "inputIndex": {
          "format": "uint",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "requestJsonPointer": {
          "type": "string"
        },
        "textRange": {
          "anyOf": [
            {
              "$ref": "#/definitions/ThreadContextWindowTextRange"
            },
            {
              "type": "null"
            }
          ]
        },
        "toolName": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "requestJsonPointer"
      ],
      "type": "object"
    },
    "ThreadContextWindowTextRange": {
      "properties": {
        "endByte": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "endChar": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "startByte": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "startChar": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "endByte",
        "endChar",
        "startByte",
        "startChar"
      ],
      "type": "object"
    },
    "ThreadTokenUsage": {
      "properties": {
        "contextWindowBreakdown": {
          "anyOf": [
            {
              "$ref": "#/definitions/ThreadContextWindowBreakdown"
            },
            {
              "type": "null"
            }
          ]
        },
        "last": {
          "$ref": "#/definitions/TokenUsageBreakdown"
        },
        "modelContextWindow": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "total": {
          "$ref": "#/definitions/TokenUsageBreakdown"
        }
      },
      "required": [
        "last",
        "total"
      ],
      "type": "object"
    },
    "TokenUsageBreakdown": {
      "properties": {
        "cachedInputTokens": {
          "format": "int64",
          "type": "integer"
        },
        "inputTokens": {
          "format": "int64",
          "type": "integer"
        },
        "outputTokens": {
          "format": "int64",
          "type": "integer"
        },
        "reasoningOutputTokens": {
          "format": "int64",
          "type": "integer"
        },
        "totalTokens": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "cachedInputTokens",
        "inputTokens",
        "outputTokens",
        "reasoningOutputTokens",
        "totalTokens"
      ],
      "type": "object"
    }
  },
  "properties": {
    "threadId": {
      "type": "string"
    },
    "tokenUsage": {
      "$ref": "#/definitions/ThreadTokenUsage"
    },
    "turnId": {
      "type": "string"
    }
  },
  "required": [
    "threadId",
    "tokenUsage",
    "turnId"
  ],
  "title": "ThreadTokenUsageUpdatedNotification",
  "type": "object"
}